# Copy to .env (never commit .env). Leave a line empty to keep that connector off.
# Emergency stop for every executor: set to 1
OM_KILL=

# Meta Ads (Marketing API, System User token with ads_management)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=

# Email through Resend
RESEND_API_KEY=
OM_EMAIL_FROM=

# Website publishing: local clone of the site repo (or OM_SITE_REPO_<SLUG> per product)
OM_SITE_REPO=
OM_SITE_CONTENT_DIR=content

# Automation platform webhooks (n8n / Make / Zapier / Pipedream)
OM_WEBHOOK_DEFAULT=
OM_WEBHOOK_X=
OM_WEBHOOK_LINKEDIN=
OM_WEBHOOK_REDDIT=
OM_WEBHOOK_GOOGLE_ADS=
OM_WEBHOOK_SECRET=

# Metrics: Stripe restricted read-only key
STRIPE_API_KEY=

# ── Extended connectors (tools/connectors/*.mjs). Each stays off until its keys are set. ──
# MCP approve_item: owner token (16+ random characters). Do NOT put it here: agents can read .env. Set it only
# in the environment of the process that starts the MCP server. Keep this line empty.
WHALYOM_OWNER_TOKEN=
# Optional Pro/Agency license key (offline check; empty = Free edition)
WHALYOM_LICENSE_KEY=

# Indexing: IndexNow key (also host the key file at https://<domain>/<key>.txt)
INDEXNOW_KEY=
INDEXNOW_HOST=
INDEXNOW_KEY_LOCATION=
# Google (Search Console sitemaps, GA4 Data API, Google Ads): an access token, or the refresh-token trio
GSC_SITE_URL=
GOOGLE_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Social posting (approval type "post", channel = connector name)
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
BLUESKY_PDS=
MASTODON_URL=
MASTODON_TOKEN=
MASTODON_MAX_CHARS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
# X API v2: OAuth 1.0a user context (all four) or an OAuth 2.0 user token with tweet.write
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_USER_ACCESS_TOKEN=
# LinkedIn Posts API: token with w_member_social or w_organization_social; author urn:li:person:<id> or urn:li:organization:<id>
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_VERSION=
# Buffer (legacy v1 tokens only)
BUFFER_ACCESS_TOKEN=
BUFFER_PROFILE_IDS=

# Blogs (approval type "publish", channel devto/hashnode/medium/wordpress/ghost; drafts unless activate: true)
DEVTO_API_KEY=
HASHNODE_TOKEN=
HASHNODE_PUBLICATION_ID=
MEDIUM_TOKEN=
WP_URL=
WP_USER=
WP_APP_PASSWORD=
GHOST_ADMIN_URL=
GHOST_ADMIN_API_KEY=

# Newsletters (approval type "send", channel mailchimp/brevo/convertkit/newsletter; campaign drafts only, never sent)
OM_EMAIL_FROM_NAME=
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
BREVO_API_KEY=
BREVO_LIST_ID=
KIT_API_KEY=

# Search ads APIs (approval type "spend"; created paused unless activate: true)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=
MSADS_DEVELOPER_TOKEN=
MSADS_ACCESS_TOKEN=
MSADS_CUSTOMER_ID=
MSADS_ACCOUNT_ID=
MSADS_REST_BASE=
# Social ads APIs (approval type "spend"; TikTok created DISABLE, LinkedIn group DRAFT + campaign PAUSED, unless activate: true)
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
# LINKEDIN_ACCESS_TOKEN (above) needs the rw_ads scope for ads
LINKEDIN_AD_ACCOUNT_ID=
LINKEDIN_ADS_VERSION=
LINKEDIN_CURRENCY=
# Reddit Ads API v3 (channel reddit; created PAUSED unless activate: true)
REDDIT_ADS_ACCESS_TOKEN=
REDDIT_ADS_ACCOUNT_ID=
# X Ads API (channel x_ads; plain "x" is organic posting). OAuth 1.0a user context; entity_status PAUSED unless activate: true
X_ADS_CONSUMER_KEY=
X_ADS_CONSUMER_SECRET=
X_ADS_ACCESS_TOKEN=
X_ADS_ACCESS_SECRET=
X_ADS_ACCOUNT_ID=
X_ADS_FUNDING_INSTRUMENT_ID=
# Apple Search Ads API v5 (channel apple). APPLE_ADS_PRIVATE_KEY is the PEM; 
 escapes are fine on one line
APPLE_ADS_CLIENT_ID=
APPLE_ADS_TEAM_ID=
APPLE_ADS_KEY_ID=
APPLE_ADS_PRIVATE_KEY=
APPLE_ADS_ORG_ID=
# Without ads API keys: set to 1 to export Google/Microsoft Editor CSVs and TikTok/Reddit setup sheets to outbox/exports/
OM_ADS_CSV_EXPORT=

# Read-only metrics (MCP metrics_pull → metrics/inbox → metrics_ingest)
PLAUSIBLE_API_KEY=
PLAUSIBLE_SITE_ID=
PLAUSIBLE_URL=
UMAMI_WEBSITE_ID=
UMAMI_API_KEY=
UMAMI_URL=
UMAMI_TOKEN=
GA4_PROPERTY_ID=

# Booking links (MCP booking_links → research/booking-links.json)
CALCOM_API_KEY=
CALCOM_USERNAME=
CALENDLY_TOKEN=

# Install-and-go edge (tools/cloud/edge.mjs, tools/install-snippet.mjs)
OM_INSTALL_KEY=
OM_EDGE_URL=
OM_EDGE_PORT=
OM_EDGE_DOMAINS=
OM_EDGE_MAX_NEW_SITES=
OM_AUTO_IGNITE=
# 1 when the edge runs behind a reverse proxy (set automatically in deploy/cloud/docker-compose.yml)
OM_EDGE_TRUST_PROXY=
OM_EDGE_HOST=
# Self-serve sign-up and billing for other companies (tools/cloud/tenants.mjs, tools/cloud/billing.mjs).
# STRIPE_SECRET_KEY can write Checkout sessions (separate from the read-only STRIPE_API_KEY above).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=
STRIPE_PRICE_AGENCY=
OM_BILLING_SUCCESS_URL=
OM_BILLING_CANCEL_URL=
OM_SIGNUP_ENABLED=
OM_SIGNUPS_PER_HOUR=
OM_MAX_SIGNUPS_PER_DAY=
# Optional path to the claude executable for headless runs (default: claude / claude.exe on PATH)
OM_CLAUDE_BIN=

# Less common settings read by tools/ (leave empty for the defaults)
WHALYOM_PORT=
OM_SITE_BASE_URL=
OM_KNOWLEDGE_OFFLINE=
WHALYOM_SECRET=
WHALYOM_ALLOWED_ORIGINS=
WHALYOM_MAX_BODY=
WHALYOM_MAX_SKEW=
CALCOM_API_VERSION=
CALCOM_BOOKING_BASE=
MSADS_TIMEZONE=
INDEXNOW_ENDPOINT=
BUFFER_API_URL=

# Whalyom Cloud (deploy/CLOUD.md)
ANTHROPIC_API_KEY=
OM_SERVER_HOST=
OM_DASHBOARD_PASSWORD=
OM_DASHBOARD_DOMAIN=
OM_EDGE_DOMAIN=
OM_DAILY_RUN_HOUR=

# Whalyom online app (tools/cloud/web.mjs): landing page, sign up and sign in, customer panel, admin panel.
# Customers enter their site address and cPanel or SSH access in the panel; it is stored encrypted, never in .env.
# OM_WEB_SECRET: 32+ random characters; created on first start if empty. Changing it signs everyone out and makes stored site access unreadable.
OM_WEB_SECRET=
# The email that becomes the admin when it signs up.
OM_ADMIN_EMAIL=
# Port the hub starts the app on (the cloud compose file sets 8080). Empty: the app is not started.
OM_WEB_PORT=
OM_APP_DOMAIN=
# Payment instructions shown on the billing page while payments are cash or bank transfer.
OM_PAY_INSTRUCTIONS=
# 0 closes public sign up.
OM_WEB_SIGNUP=

# Organic social publishing and the social inbox (tools/connectors/instagram.mjs, facebook.mjs, tiktok-posting.mjs, tools/social-inbox.mjs)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Optional: graph.facebook.com (default) or graph.instagram.com; poll settings for video containers
INSTAGRAM_API_BASE=
INSTAGRAM_POLL_ATTEMPTS=
INSTAGRAM_POLL_MS=
INSTAGRAM_USERNAME=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
# TikTok Content Posting API: a separate token from TIKTOK_ACCESS_TOKEN (ads)
TIKTOK_POSTING_ACCESS_TOKEN=

# Retail media (tools/connectors/amazon-ads.mjs, walmart-connect.mjs). Amazon campaigns PAUSED unless activate: true; Walmart never activated
AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_CLIENT_SECRET=
AMAZON_ADS_REFRESH_TOKEN=
AMAZON_ADS_PROFILE_ID=
# na, eu or fe
AMAZON_ADS_REGION=
AMAZON_ADS_REPORT_POLLS=
WALMART_ADS_CONSUMER_ID=
# PEM or bare base64 PKCS8
WALMART_ADS_PRIVATE_KEY=
WALMART_ADS_AUTH_TOKEN=
WALMART_ADS_ADVERTISER_ID=
WALMART_ADS_KEY_VERSION=
# Sandbox base URL when testing
WALMART_ADS_BASE=
WALMART_ADS_REPORT_POLLS=

# AI image and video creative (tools/creative-gen.mjs). Also needs product.json creative.monthly_cap
OPENAI_API_KEY=
STABILITY_API_KEY=
RUNWAYML_API_SECRET=
LUMAAI_API_KEY=
OM_CREATIVE_IMAGE_PROVIDER=
OM_CREATIVE_VIDEO_PROVIDER=
OPENAI_IMAGE_MODEL=
STABILITY_IMAGE_MODEL=
RUNWAY_VIDEO_MODEL=
RUNWAY_API_VERSION=
LUMA_VIDEO_MODEL=

# Voice calls through Twilio (tools/connectors/voice.mjs; approval type "call", never auto-approved)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional API key pair instead of the auth token for REST calls
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# E.164 number the calls come from
TWILIO_VOICE_FROM=
# https base the webhooks are reached at, e.g. https://<edge>/voice/<slug>
TWILIO_VOICE_WEBHOOK_BASE=
TWILIO_VOICE_RELAY_URL=
TWILIO_VOICE_HANDOFF=

# Real-time feed on the edge (tools/cloud/realtime.mjs; owner token is WHALYOM_OWNER_TOKEN above, 16+ characters)
OM_LIVE_MAX_CLIENTS=

# Claude Platform API key for all headless AI work (hub runs, scheduled workflows, lead replies).
# Billing goes to Claude Platform, never the Claude Code subscription. Required: without it no AI run starts.
WHALYOM_ANTHROPIC_API_KEY=
# Optional: override the monthly AI budget of the current mode (USD).
OM_AI_MONTHLY_BUDGET_USD=

# Site access per product for tools/add-product.mjs (SLUG = product slug in capitals, e.g. WHALORY_COM).
# cPanel: an API token from cPanel → Security → Manage API Tokens.
# OM_CPANEL_URL_SLUG=https://host:2083
# OM_CPANEL_USER_SLUG=
# OM_CPANEL_TOKEN_SLUG=
# SSH: OM_SSH_TARGET_SLUG=user@host or user@host:port, OM_SSH_KEY_SLUG=path to the private key file
