  "motion": {
    "fast": {
      "$type": "duration",
      "$value": "140ms"
    },
    "standard": {
      "$type": "duration",
      "$value": "220ms"
    },
    "slow": {
      "$type": "duration",
      "$value": "400ms"
    },
    "ease": {
      "$type": "cubicBezier",
      "$value": [
        0.2,
        0.65,
        0.3,
        1
      ]
    },
    "$description": "Animate changes of state and selection. Avoid perpetual rotation and flashing. Stop nonessential animation for prefers-reduced-motion."
  },
  "logo": {
    "$description": "Use supplied artwork; never set the wordmark as live text or mirror the whole asset.",
    "english": {
      "asset": "logos/whalyom-horizontal-en.png",
      "alt": "WHALYOM",
      "physicalOrder": [
        "symbol-left",
        "wordmark-right"
      ],
      "displaySpelling": "WHA⅃YOM",
      "mirroredLetter": "Only L: stem on right, bottom foot to left."
    },
    "persian": {
      "asset": "logos/whalyom-horizontal-fa.png",
      "alt": "والیوم",
      "physicalOrder": [
        "wordmark-left",
        "symbol-right"
      ],
      "language": "fa",
      "direction": "rtl"
    },
    "symbol": {
      "asset": "logos/whalyom-symbol.png",
      "mirrorForRtl": false,
      "brassSegment": "Keep its position unchanged in both languages."
    }
  },
  "content": {
    "status": {
      "active": {
        "fa": "در حال کار",
        "en": "Working",
        "icon": "activity",
        "meaning": "An action is executing now."
      },
      "waiting": {
        "fa": "در صف",
        "en": "Queued",
        "icon": "clock",
        "meaning": "A scheduled action has not started."
      },
      "needsApproval": {
        "fa": "نیازمند تأیید",
        "en": "Needs approval",
        "icon": "approval",
        "meaning": "The user must decide before execution continues."
      },
      "blocked": {
        "fa": "متوقف",
        "en": "Blocked",
        "icon": "alert",
        "meaning": "Execution needs an intervention; show the cause and next step."
      },
      "completed": {
        "fa": "انجام‌شده",
        "en": "Completed",
        "icon": "check",
        "meaning": "Execution ended; do not imply business success unless measured."
      }
    },
    "emptyApproval": {
      "faTitle": "موردی برای تأیید ندارید",
      "faBody": "وقتی اقدامی به تصمیم شما نیاز داشته باشد، همین‌جا نمایش داده می‌شود.",
      "enTitle": "No approvals are waiting",
      "enBody": "When a proposed action needs your decision, it will appear here."
    }
  },
  "format": "whalyom-token-map-v1",
  "version": "1.0"
}
