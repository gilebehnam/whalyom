    },
    "focusOffset": {
      "$type": "dimension",
      "$value": "5px"
    }
  },
  "size": {
    "controlMinHeight": {
      "$type": "dimension",
      "$value": "44px"
    },
    "headerSymbol": {
      "$type": "dimension",
      "$value": "44px"
    },
    "fullSymbolRecommendedMinimum": {
      "$type": "dimension",
      "$value": "32px",
      "$description": "A practical recommendation, not proof of verified legibility at every rendering size. Inspect the final deployed mark."
    },
    "logoGap": {
      "$type": "dimension",
      "$value": "16px"
    },
    "contentMax": {
      "$type": "dimension",
      "$value": "1280px"
    }
