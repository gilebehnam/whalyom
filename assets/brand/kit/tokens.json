{
  "$description": "WHALYOM visual identity v1.0. Typed token map for handoff; confirm importer-specific conversion before use. Proposed brand handoff based on the supplied screenshots and approved bilingual logo. No external font or product repository is bundled.",
  "color": {
    "background": {
      "$type": "color",
      "$value": "#090D10",
      "$description": "Main near-black canvas."
    },
    "surface": {
      "$type": "color",
      "$value": "#0C1B20",
      "$description": "Deep-teal panel surface."
    },
    "raised": {
      "$type": "color",
      "$value": "#10262C",
      "$description": "Elevated cards, focused work areas and hover surfaces."
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "#D5D3C8"
      },
      "secondary": {
        "$type": "color",
        "$value": "#A8B8BA"
      },
      "quiet": {
        "$type": "color",
        "$value": "#81999E",
        "$description": "Tertiary labels; still a readable foreground on the designated dark surfaces."
      }
    },
    "brand": {
      "ivory": {
        "$type": "color",
        "$value": "#D5D3C8"
      },
      "brass": {
        "$type": "color",
        "$value": "#AD9570",
        "$description": "Identity and restrained editorial accents; do not substitute this for the action color."
      }
    },
    "interaction": {
      "primary": {
        "$type": "color",
        "$value": "#E4BE4B",
        "$description": "Primary action and explicit attention state. Pair with ink text."
      },
      "primaryHover": {
        "$type": "color",
        "$value": "#EDD17F"
      },
      "primaryText": {
        "$type": "color",
        "$value": "#090D10"
      },
      "focus": {
        "$type": "color",
        "$value": "#8EDDE2"
      },
      "selected": {
        "$type": "color",
        "$value": "#8EDDE2"
      }
    },
    "data": {
      "orbit": {
        "$type": "color",
        "$value": "#8EDDE2",
        "$description": "Data lines and selection. Reduce decorative opacity, not label contrast."
      }
    },
    "border": {
      "control": {
        "$type": "color",
        "$value": "#607A81",
        "$description": "Inputs and interactive boundaries."
      },
      "divider": {
        "$type": "color",
        "$value": "#29434A",
        "$description": "Decorative separation only; not a control boundary."
      }
    },
    "status": {
      "active": {
        "$type": "color",
        "$value": "#8EDDE2"
      },
      "waiting": {
        "$type": "color",
        "$value": "#A8B8BA"
      },
      "needsApproval": {
        "$type": "color",
        "$value": "#E4BE4B"
      },
      "blocked": {
        "$type": "color",
        "$value": "#DF9993"
      },
      "completed": {
        "$type": "color",
        "$value": "#8EC6A7"
      },
      "information": {
        "$type": "color",
        "$value": "#9DBBDD"
      }
    }
  },
  "font": {
    "family": {
      "fa": {
        "$type": "fontFamily",
        "$value": [
          "Ravi",
          "Vazirmatn",
          "Noto Sans Arabic",
          "Tahoma",
          "sans-serif"
        ],
        "$description": "Ravi is preferred only when the owner supplies a licensed font. No font file is included. Local installed fallbacks are used otherwise."
      },
      "en": {
        "$type": "fontFamily",
        "$value": [
          "Inter",
          "Aptos",
          "Segoe UI",
          "Arial",
          "sans-serif"
